# Copy to secrets.env and `chmod 600 secrets.env`. Never commit the real file.
# Values come from each Rail Data Marketplace subscription's "Access credentials" page.

# Required: TRAIN_MVT_ALL_TOC (TRUST train movements)
MVT_BOOTSTRAP=pkc-xxxxx.europe-west2.gcp.confluent.cloud:9092
MVT_USERNAME=
MVT_PASSWORD=
MVT_GROUP=SC-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MVT_TOPIC=TRAIN_MVT_ALL_TOC

# Optional: VSTP (short-notice schedules). Leave blank until subscribed.
VSTP_BOOTSTRAP=
VSTP_USERNAME=
VSTP_PASSWORD=
VSTP_GROUP=
VSTP_TOPIC=
